add_private_includes(src)
add_public_includes(other include ../../ext)
configure_engine_target()

# add GLAD
add_sources(../../ext/glad/src/gl.c)
add_sources(../../ext/glad/include/KHR/khrplatform.h)
add_sources(../../ext/glad/include/glad/gl.h)
if OS_LINUX
    add_sources(../../ext/glad/src/glx.c)
    add_sources(../../ext/glad/include/glad/glx.h)
endif
add_public_includes(../../ext/glad/include)

if BUILD_DEBUG
    add_subproject(../memcheck)
    link_target(memcheck)
endif

duplicate_target(engine_lib engine_lib_for_editor)
add_macro(ENGINE_DEBUG_TOOLS) # editor needs debug tools even in release
add_macro(ENGINE_EDITOR)
